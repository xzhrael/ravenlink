# ==============================================================================
# Ravenlink - Environment Variables Configuration
# ==============================================================================

# Database Connection (MySQL / MariaDB on cPanel or Local)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://cpaneluser_ravenlink:StrongPasswordHere123@localhost:3306/cpaneluser_ravenlink_db"

# NextAuth / Auth.js Configuration
# Generate a secure 32+ byte string using: `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-very-strong-secret-key-min-32-chars-base64"
NEXTAUTH_SECRET="replace-with-a-very-strong-secret-key-min-32-chars-base64"

# Base URL of the Application
# In development: http://localhost:3000
# In production (cPanel): https://yourdomain.com (WAJIB HTTPS untuk Google OAuth)
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 Credentials (Console Google Cloud)
# Authorized JavaScript origins: https://yourdomain.com
# Authorized redirect URIs: https://yourdomain.com/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Super Admin Designation
# Set to your own personal/work email to automatically grant full Super Admin privileges upon login
SUPER_ADMIN_EMAIL="youremail@example.com"

# Email Delivery Configuration (SMTP / Gmail / Custom SMTP)
# Untuk Gmail: aktifkan 2-Step Verification & buat Sandi Aplikasi di https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="youremail@gmail.com"
SMTP_PASSWORD="your-16-digit-app-password"
SMTP_FROM="\"Ravenlink\" <youremail@gmail.com>"

# Node Environment
NODE_ENV="development"
PORT="3000"
