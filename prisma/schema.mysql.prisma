// Prisma schema for MySQL (Target Hosting cPanel / Production)

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String            @id @default(cuid())
  name                  String?
  email                 String?           @unique
  emailVerified         DateTime?
  image                 String?
  username              String?           @unique
  password              String?
  bio                   String?           @db.Text
  
  // Theme customizer preferences (Neo-Brutalism neutral palette defaults)
  themeBackground       String            @default("#FFF8E7")
  themeAccent           String            @default("#3772FF")
  themeTextColor        String            @default("#0D0D0D")
  themeButtonColor      String            @default("#FFDE59")
  themeButtonTextColor  String            @default("#0D0D0D")
  themeCardStyle        String            @default("brutal-solid")
  themeFont             String            @default("space-grotesk")

  // NextAuth Relations
  accounts              Account[]
  sessions              Session[]

  // Linktree content relations
  links                 Link[]

  // Roles & Account Status (Enterprise Super Admin)
  role                  String            @default("USER")
  status                String            @default("ACTIVE")

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([username])
  @@index([email])
  @@index([role])
  @@index([status])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum LinkCategory {
  SOCIAL
  PRODUCT
  CUSTOM
  CONTACT
}

model Link {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  title           String          @db.VarChar(255)
  url             String          @db.Text
  icon            String?         @db.VarChar(100)
  subtitle        String?         @db.Text
  customThumbnail String?         @db.Text
  isActive        Boolean         @default(true)
  position        Int             @default(0)

  // Scheduling
  startDate       DateTime?
  endDate         DateTime?

  // Category & Click metrics
  category        LinkCategory    @default(CUSTOM)
  clicks          Int             @default(0)

  analytics       ClickAnalytics[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([userId, position])
  @@index([isActive])
}

model ClickAnalytics {
  id        String   @id @default(cuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  referrer  String?  @db.VarChar(500)
  userAgent String?  @db.VarChar(500)
  ipHash    String?  @db.VarChar(64)
  country   String?  @db.VarChar(10)

  createdAt DateTime @default(now())

  @@index([linkId])
  @@index([createdAt])
}
